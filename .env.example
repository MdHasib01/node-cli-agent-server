PORT=6000
DEFAULT_CLI=codex
# "default" means no --model flag is passed, so the CLI uses its own default model.
DEFAULT_MODEL=gpt-5.6-sol
# Image generation with reference photos regularly takes several minutes.
CLI_TIMEOUT=600000
# Optional legacy key. API calls now authenticate with per-user tokens created in the dashboard;
# when API_KEY is set, "Authorization: Bearer <API_KEY>" is accepted as well.
API_KEY=
# Public domain URL for generated assets (e.g. images). Defaults to http://localhost:PORT
BASE_URL=http://localhost:6000

# MongoDB connection string, including the database name, e.g. mongodb+srv://user:pass@cluster/agents
MONGODB_URI=

# Signs dashboard session cookies. Use a long random value; changing it signs everyone out.
JWT_SECRET=
SESSION_DAYS=7
# Send the session cookie over HTTPS only (defaults to true when NODE_ENV=production).
COOKIE_SECURE=false
# Set to false after creating your accounts to stop public sign-ups (the first account is always allowed).
ALLOW_REGISTRATION=true

# Cron schedules used the first time each job is created; edit them afterwards from the dashboard.
USAGE_CHECK_SCHEDULE=*/5 * * * *
TOKEN_REVIEW_SCHEDULE=*/15 * * * *

# Read local Claude Code / Codex session logs to show provider usage limits.
PROVIDER_USAGE_SCAN=true
# Override where those CLIs keep their data (defaults: ~/.claude and ~/.codex).
# CLAUDE_CONFIG_DIR=
# CODEX_HOME=

# Full path to a CLI's executable, only needed when it isn't found automatically. The server
# already checks its own PATH, the current user/system PATH (so no restart is needed after
# installing a CLI) and each CLI's usual install folder.
# CLAUDE_BIN=
# AGY_BIN=
# CODEX_BIN=
